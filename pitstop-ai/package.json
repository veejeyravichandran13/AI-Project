{
  "name": "pitstop-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/build-data.mjs && next dev",
    "build": "node scripts/build-data.mjs && next build",
    "start": "npx --yes serve@14 out -l 3000",
    "build:data": "node scripts/build-data.mjs",
    "validate:data": "for f in data-src/[!b]*.json data-src/b[!r]*.json; do node scripts/validate.mjs $f || exit 1; done",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-query": "^5.104.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.43.0",
    "next": "15.5.27",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.7.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.89.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.27",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.7"
  },
  "description": "Pitstop AI — Phase 1 React frontend for choosing a new car in India (mock data only).",
  "engines": {
    "node": ">=20"
  }
}
